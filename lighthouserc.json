{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/projects/customer-route-analytics-power-bi/",
        "http://localhost:4321/projects/daily-revenue-pipeline/",
        "http://localhost:4321/projects/competitor-price-tracker/",
        "http://localhost:4321/projects/operational-log-parser/",
        "http://localhost:4321/projects/revenue-audit-engine/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
