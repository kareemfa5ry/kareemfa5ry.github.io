{
  "name": "kareemfa5ry-github-io",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check:layout": "node scripts/check_layout.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \".claude/skills/project-demo/scripts/*.test.mjs\"",
    "test:e2e": "playwright test",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:test": "tsc -p worker/tsconfig.json && node --test \"worker/test/*.test.mjs\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:layout && npm run test:unit && npm run worker:test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.2",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0"
  }
}
