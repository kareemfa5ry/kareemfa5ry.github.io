---
// The CV page: composes the sections from the content collections and src/site/profile.ts.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import Downloads from "../components/Downloads.astro";
import { getCollection } from "astro:content";
import { FULL_NAME } from "../site/contact";
import { PROFILE_SUMMARY, STATS, TAGLINE } from "../site/profile";

const PAGE = {
  title: `${FULL_NAME} — Revenue & Data Analytics`,
  description:
    `${FULL_NAME}: ` +
    "data analyst and revenue manager with 15 years in airline revenue, pricing and operations. SQL, Python, Power BI.",
  ogDescription:
    "15 years in airline revenue, pricing and operations. SQL, Python, Power BI, forecasting and revenue assurance.",
};

const byOrder = <T extends { data: { order: number } }>(entries: T[]) =>
  [...entries].sort((a, b) => a.data.order - b.data.order);
const experience = byOrder(await getCollection("experience"));
const projects = byOrder(await getCollection("projects"));
const skills = byOrder(await getCollection("skills"));

const EDUCATION = [
  "BSc Accounting, Alexandria University, Faculty of Commerce (English section), 2010",
  "ATPCO fare filing and coding, two-week instructor-led programme",
  "Business Process Outsourcing Skills Programme, Information Technology Institute (ITI), nine months",
  "Arabic (native) · English (full professional) · French (basic)",
];
---

<Base title={PAGE.title} description={PAGE.description} ogDescription={PAGE.ogDescription}>
  <Hero tagline={TAGLINE} />

  <section id="profile">
    <h2>Profile</h2>
    <p>{PROFILE_SUMMARY}</p>
    <Stats stats={STATS} />
  </section>

  <section id="experience">
    <h2>Experience</h2>
    {experience.map((entry) => (
      <ExperienceEntry entry={entry} />
    ))}
  </section>

  <section id="projects">
    <h2>Projects</h2>
    {projects.map((entry) => (
      <ProjectEntry entry={entry} />
    ))}
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <SkillsGrid groups={skills} />
  </section>

  <section id="education">
    <h2>Education, training and languages</h2>
    <ul>
      {EDUCATION.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  </section>

  <Downloads />
</Base>
