---
// The CV page: composes the sections from the content collections and src/site/profile.ts.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import ExperienceEntry from "../components/ExperienceEntry.astro";
import ProjectEntry from "../components/ProjectEntry.astro";
import FeaturedProject from "../components/projects/FeaturedProject.astro";
import SkillsGrid from "../components/SkillsGrid.astro";
import Downloads from "../components/Downloads.astro";
import ChatShowcase from "../components/sections/ChatShowcase.astro";
import Contact from "../components/sections/Contact.astro";
import ProjectFilter from "../islands/ProjectFilter.tsx";
import { getCollection } from "astro:content";
import { CHAT_ENABLED } from "../site/chat";
import { FULL_NAME } from "../site/contact";
import { EDUCATION, LANGUAGES } from "../site/education";
import { personJsonLd } from "../site/person_jsonld";
import { PROFILE_SUMMARY, TAGLINE } from "../site/profile";
import { byOrder } from "../site/collections/by_order";

const PAGE = {
  title: `${FULL_NAME} — Revenue & Data Analytics`,
  description:
    `${FULL_NAME}: ` +
    "data analyst and revenue manager with 15 years in airline revenue, pricing and operations. SQL, Python, Power BI.",
  ogDescription:
    "15 years in airline revenue, pricing and operations. SQL, Python, Power BI, forecasting and revenue assurance.",
};

const experience = byOrder(await getCollection("experience"));
const projects = byOrder(await getCollection("projects"));
const skills = byOrder(await getCollection("skills"));
const filterGroups = skills.map(({ id, data }) => ({ id, label: data.label }));
const filterProjects = projects.map(({ id, data }) => ({
  slug: id,
  title: data.title,
  skills: data.skills.map((skill) => skill.id),
}));
---

<Base
  numbered
  title={PAGE.title}
  description={PAGE.description}
  ogDescription={PAGE.ogDescription}
  jsonLd={personJsonLd(skills.map(({ data }) => data.label))}
>
  <Hero tagline={TAGLINE} />
  {CHAT_ENABLED && <ChatShowcase />}

  <section id="profile">
    <h2>Profile</h2>
    <p>{PROFILE_SUMMARY}</p>
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <ProjectFilter client:idle groups={filterGroups} projects={filterProjects} />
    <div class="project-rows">
      {projects
        .filter(({ data }) => data.screenshots.length > 0)
        .map((entry) => (
          <FeaturedProject entry={entry} />
        ))}
    </div>
    <div class="project-grid">
      {projects
        .filter(({ data }) => data.screenshots.length === 0)
        .map((entry) => (
          <ProjectEntry entry={entry} />
        ))}
    </div>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <ol class="timeline">
      {experience.map((entry) => (
        <ExperienceEntry entry={entry} />
      ))}
    </ol>
  </section>

  <section id="skills">
    <h2>Skills</h2>
    <SkillsGrid groups={skills} projects={projects} />
  </section>

  <section id="education">
    <h2>Education, training and languages</h2>
    <ul>
      {[...EDUCATION, LANGUAGES].map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  </section>

  <Downloads />
  <Contact />
</Base>

<style>
  .project-rows,
  .project-grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
