---
// Animated walkthrough of a project: the generated demo page in an iframe, 16:9 reserved up front.
interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;
const src = `/demos/${slug}/`;
---

<section id="demo">
  <h2>Demo</h2>
  <div class="frame">
    <img class="only-light" src={`${src}poster.jpg`} width="1280" height="720" alt="" loading="lazy" decoding="async" />
    <img
      class="only-dark"
      src={`${src}poster-dark.jpg`}
      width="1280"
      height="720"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <iframe
      src={src}
      title={`Animated walkthrough: ${title}`}
      loading="lazy"
      allow=""
      referrerpolicy="same-origin"
    ></iframe>
  </div>
  <p>
    <a href={src}>Open full screen</a>
  </p>
</section>

<style>
  .frame {
    aspect-ratio: 16 / 9;
    position: relative;
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
