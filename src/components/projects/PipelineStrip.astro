---
// "How it works": the stages of one pipeline shot as an ordered list, arrows between them drawn in CSS.
import type { Pipeline } from "./demos";

interface Props {
  pipeline: Pipeline;
}

const { heading, caption, stages } = Astro.props.pipeline;
---

<section class="pipeline">
  <h2>{heading}</h2>
  <p class="caption">{caption}</p>
  <ol aria-label={`${heading}, ${stages.length} steps`}>
    {stages.map(({ label, detail }) => (
      <li>
        <strong>{label}</strong>
        {detail && <span>{detail}</span>}
      </li>
    ))}
  </ol>
</section>

<style>
  .caption {
    color: var(--muted);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  /* Plain bordered items; move onto the shared .card class once it is merged. */
  li {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  li span {
    color: var(--muted);
    font-size: 14px;
  }
  /* The arrow: a decorative glyph in the gap after every stage but the last. */
  li:not(:last-child)::after {
    content: "↓";
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    width: 28px;
    line-height: 28px;
    text-align: center;
    color: var(--accent);
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    ol {
      flex-direction: row;
      gap: 36px;
    }
    li:not(:last-child)::after {
      content: "→";
      left: 100%;
      top: 50%;
      width: 36px;
      transform: translateY(-50%);
    }
  }
  @media print {
    li {
      break-inside: avoid;
    }
  }
</style>
