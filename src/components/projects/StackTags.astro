---
// Technology tags (chips) for a project, in the order written in the project file.
interface Props {
  stack: string[];
}

const { stack } = Astro.props;
---

<div class="tags">
  {stack.map((tag) => (
    <span class="tag">{tag}</span>
  ))}
</div>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  .tag {
    font-size: 13px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
