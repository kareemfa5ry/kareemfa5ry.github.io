---
// Technology tags (chips) for a project, in the order written in the project file.
interface Props {
  stack: string[];
}

const { stack } = Astro.props;
---

<div class="tags">
  {stack.map((tag) => (
    <span class="chip pop">{tag}</span>
  ))}
</div>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
  /* The border the .pop hover lights up. In project cards the stretched title link sits on top, so the card lifts. */
  .chip {
    border: 1px solid var(--tag-rule);
    background: var(--tag-bg);
    color: var(--tag-ink);
  }
</style>
