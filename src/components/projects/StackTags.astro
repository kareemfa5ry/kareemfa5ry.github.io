---
// Technology tags (chips) for a project, in the order written in the project file.
interface Props {
  stack: string[];
}

const { stack } = Astro.props;
---

<div class="tags">
  {stack.map((tag) => (
    <span class="chip">{tag}</span>
  ))}
</div>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }
</style>
