---
// "Download CV" section: one card per published PDF in public/assets/cv/.
import { CV_FILES } from "../site/cv_files";
---

<section id="download">
  <h2>Download CV</h2>
  <div class="downloads">
    {CV_FILES.map((cv) => (
      <div class="dl">
        <h3>{cv.title}</h3>
        <p>{cv.blurb}</p>
        <a class="btn primary" href={cv.href} download>
          Download PDF
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .downloads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
  }
  .dl {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 18px;
  }
  .dl p {
    margin: 4px 0 12px;
    color: var(--muted);
    font-size: 15px;
  }
  @media print {
    #download {
      display: none;
    }
  }
</style>
