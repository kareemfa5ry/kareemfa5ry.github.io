---
// Skill groups from the skills collection, two columns from 640px up.
import type { CollectionEntry } from "astro:content";

interface Props {
  groups: CollectionEntry<"skills">[];
}

const { groups } = Astro.props;
---

<div class="skills">
  {groups.map(({ id, data }) => (
    <div id={id}>
      <b>{data.label}</b>
      <p>{data.items.join(", ")}</p>
    </div>
  ))}
</div>

<style>
  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .skills {
      grid-template-columns: 1fr 1fr;
    }
  }
  .skills div b {
    display: block;
    font-size: 15px;
  }
  .skills div p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 15px;
  }
</style>
