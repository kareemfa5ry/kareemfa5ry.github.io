---
// Sticky top bar: brand link, in-page section links and the light/dark theme toggle.
import { FULL_NAME } from "../site/contact";
import ThemeToggle from "./theme/ThemeToggle.astro";

const LINKS = [
  { href: "#projects", label: "Projects" },
  { href: "#experience", label: "Experience" },
  { href: "#skills", label: "Skills" },
  { href: "#download", label: "CV", sr: "Download ", button: true },
];
---

<nav>
  <div class="wrap">
    <a class="brand" href="#top">
      {FULL_NAME}
    </a>
    <div class="links">
      {LINKS.map((link) => (
        <a href={link.href} class={link.button ? "btn primary" : undefined}>
          <span>
            {link.sr && <span class="sr">{link.sr}</span>}
            {link.label}
          </span>
        </a>
      ))}
    </div>
    <ThemeToggle />
  </div>
</nav>

<script>
  // Mark the link of the section crossing the middle of the viewport. Sections absent (project pages) are skipped.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]')];
  const observer = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) =>
          a.getAttribute("href") === `#${entry.target.id}`
            ? a.setAttribute("aria-current", "location")
            : a.removeAttribute("aria-current"),
        );
      }),
    { rootMargin: "-45% 0px -50% 0px" },
  );
  links.forEach((a) => {
    const section = document.getElementById(a.getAttribute("href")!.slice(1));
    if (section?.tagName === "SECTION") observer.observe(section);
  });
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  nav .wrap {
    display: flex;
    gap: 20px;
    align-items: center;
    height: 52px;
    overflow-x: auto;
    white-space: nowrap;
  }
  nav .brand {
    font-weight: 700;
    color: var(--ink);
    margin-right: auto;
    text-decoration: none;
  }
  nav a:not(.brand, .btn) {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  nav a:not(.brand, .btn):hover,
  nav a[aria-current="location"]:not(.btn) {
    color: var(--ink);
  }
  /* Underline as well as colour, so the state does not rely on colour alone. */
  nav a[aria-current="location"]:not(.btn) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  /* Desktop: the links sit in the bar's own row and the full "Download CV" shows. */
  nav .links {
    display: contents;
  }
  /* Phones: brand and switch on the first row, links on a second; "Download " stays for screen readers only so
     "CV" fits at 320px. Every target is at least 44px tall. */
  @media (max-width: 639px) {
    nav .wrap {
      flex-wrap: wrap;
      gap: 0 12px;
      height: auto;
      overflow: visible;
    }
    nav .brand {
      flex: 1;
      min-width: 0;
    }
    nav .links {
      display: flex;
      order: 1;
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }
    nav .brand,
    nav .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
    nav .wrap :global(.plane-switch) {
      min-height: 44px;
    }
    nav .sr {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
  @media print {
    nav {
      display: none;
    }
  }
</style>
