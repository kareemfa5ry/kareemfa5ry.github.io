---
// One project from the projects collection: linked title, context, bullet list and technology tags.
// data-project carries the slug so src/islands/ProjectFilter.tsx can show and hide the entry.
import StackTags from "./projects/StackTags.astro";
import { demoDuration, hasDemo } from "./projects/demos";
import { bulletsFor, smartQuotes } from "../site/bullets";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, org, period, stack, bullets } = entry.data;
const meta = period ? `${org}, ${period}` : org;
---

<div class="item" data-project={entry.id}>
  <div class="item-head">
    <h3>
      <a href={`/projects/${entry.id}/`}>{title}</a>
    </h3>
    <span class="meta">{meta}</span>
  </div>
  {hasDemo(entry.id) && (
    <a class="poster" href={`/projects/${entry.id}/#demo`}>
      <img
        src={`/demos/${entry.id}/poster.jpg`}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        alt={`Animated walkthrough of ${title}`}
      />
      <span class="badge">Watch the demo · {demoDuration(entry.id)} s</span>
    </a>
  )}
  <ul>
    {bulletsFor(bullets).map((text) => (
      <li>{smartQuotes(text)}</li>
    ))}
  </ul>
  <StackTags stack={stack} />
</div>

<style>
  .poster {
    position: relative;
    display: block;
  }
  .badge {
    position: absolute;
    right: 12px;
    top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    font-size: 13px;
    color: var(--ink);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }
  .badge::before {
    content: "";
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent var(--accent);
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 8px 0;
  }
</style>
