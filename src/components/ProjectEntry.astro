---
// One project from the projects collection: linked title, context, bullet list and technology tags.
// data-project carries the slug so src/islands/ProjectFilter.tsx can show and hide the entry.
import StackTags from "./projects/StackTags.astro";
import { hasDemo } from "./projects/demos";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, org, period, stack } = entry.data;
const { Content } = await render(entry);
const meta = period ? `${org}, ${period}` : org;
---

<div class="item" data-project={entry.id}>
  <div class="item-head">
    <h3>
      <a href={`/projects/${entry.id}/`}>{title}</a>
    </h3>
    <span class="meta">{meta}</span>
  </div>
  {hasDemo(entry.id) && (
    <a href={`/projects/${entry.id}/#demo`}>
      <img
        src={`/demos/${entry.id}/poster.jpg`}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        alt={`Animated walkthrough of ${title}`}
      />
    </a>
  )}
  <Content />
  <StackTags stack={stack} />
</div>

<style>
  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 8px 0;
  }
</style>
