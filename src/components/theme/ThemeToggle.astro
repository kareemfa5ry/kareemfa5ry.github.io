---
// Nav switch between light and dark that remembers the choice for the next visit. Airplane switch design from
// Uiverse.io by Nawsome: plane in the sky (blue, clouds) = light theme, plane on the runway (lights) = dark theme.
// The look follows html[data-theme] or the system setting, so it is right before any script runs; the checkbox
// is kept in step for screen readers and keyboard users (WAI-ARIA switch: on = dark theme). The name "Dark mode"
// is the label text, shown from 640px up and visually hidden below that.
---

<label class="plane-switch">
  <input class="visually-hidden" type="checkbox" role="switch" title="Switch between light and dark mode" />
  <div class="track">
    <svg class="glyph moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 14.5A9 9 0 0 1 9.5 3 9 9 0 1 0 21 14.5Z" fill="currentColor"></path>
    </svg>
    <svg class="glyph sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="5" fill="currentColor"></circle>
      <path
        d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
    <div class="plane">
      <svg viewBox="0 0 13 13" aria-hidden="true">
        <path
          d="M1.55989957,5.41666667 L5.51582215,5.41666667 L4.47015462,0.108333333 L4.47015462,0.108333333 C4.47015462,0.0634601974 4.49708054,0.0249592654 4.5354546,0.00851337035 L4.57707145,0 L5.36229752,0 C5.43359776,0 5.50087375,0.028779451 5.55026392,0.0782711996 L5.59317877,0.134368264 L7.13659662,2.81558333 L8.29565964,2.81666667 C8.53185377,2.81666667 8.72332694,3.01067661 8.72332694,3.25 C8.72332694,3.48932339 8.53185377,3.68333333 8.29565964,3.68333333 L7.63589819,3.68225 L8.63450135,5.41666667 L11.9308317,5.41666667 C12.5213171,5.41666667 13,5.90169152 13,6.5 C13,7.09830848 12.5213171,7.58333333 11.9308317,7.58333333 L8.63450135,7.58333333 L7.63589819,9.31666667 L8.29565964,9.31666667 C8.53185377,9.31666667 8.72332694,9.51067661 8.72332694,9.75 C8.72332694,9.98932339 8.53185377,10.1833333 8.29565964,10.1833333 L7.13659662,10.1833333 L5.59317877,12.8656317 C5.55725264,12.9280353 5.49882018,12.9724157 5.43174295,12.9907056 L5.36229752,13 L4.57707145,13 L4.55610333,12.9978962 C4.51267695,12.9890959 4.48069792,12.9547924 4.47230803,12.9134397 L4.47223088,12.8704208 L5.51582215,7.58333333 L1.55989957,7.58333333 L0.891288881,8.55114605 C0.853775374,8.60544678 0.798421006,8.64327676 0.73629202,8.65879796 L0.672314689,8.66666667 L0.106844414,8.66666667 L0.0715243949,8.66058466 L0.0715243949,8.66058466 C0.0297243066,8.6457608 0.00275502199,8.60729104 0,8.5651586 L0.00593007386,8.52254537 L0.580855011,6.85813984 C0.64492547,6.67265611 0.6577034,6.47392717 0.619193545,6.28316421 L0.580694768,6.14191703 L0.00601851064,4.48064746 C0.00203480725,4.4691314 0,4.45701613 0,4.44481314 C0,4.39994001 0.0269259152,4.36143908 0.0652999725,4.34499318 L0.106916826,4.33647981 L0.672546853,4.33647981 C0.737865848,4.33647981 0.80011301,4.36066329 0.848265401,4.40322477 L0.89131128,4.45169723 L1.55989957,5.41666667 Z"
          fill="currentColor"
        ></path>
      </svg>
    </div>
    <span class="street-middle"></span>
    <span class="cloud"></span>
    <span class="cloud two"></span>
  </div>
  <span class="label-text">Dark mode</span>
</label>

<script>
  // readTheme and toggleTheme come from public/theme.js, loaded in <head> by Base.astro.
  const theme = window as unknown as { readTheme(): string; toggleTheme(): string };
  const input = document.querySelector<HTMLInputElement>(".plane-switch input");

  if (input) {
    input.checked = theme.readTheme() === "dark";
    input.addEventListener("change", () => theme.toggleTheme());
    // A checkbox toggles on Space only; a switch also toggles on Enter.
    input.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      event.preventDefault();
      input.click();
    });
  }
</script>

<style>
  /* Sticky so it stays in view while the nav links scroll sideways on narrow screens; the shadow covers the
     nav's 16px right gutter so scrolled links never show beside the switch. */
  /* Colours from the site palette (global.css): navy runway with gold lights, navy sky, gold knob.
     The two street-line tints are lighter navies added so the runway markings show on #001d3d. */
  .plane-switch {
    --dot: #ffd60a;
    --street: #001d3d;
    --street-line: #2a4d78;
    --street-line-mid: #3d6491;
    --sky-1: #003566;
    --sky-2: #001d3d;
    --light-1: rgba(255, 195, 0, 1);
    --light-2: rgba(255, 195, 0, 0.3);
    display: flex;
    align-items: center;
    gap: 8px;
    position: sticky;
    right: 0;
    flex: none;
    padding-left: 6px;
    background: var(--bg);
    box-shadow: 16px 0 0 var(--bg);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .label-text {
    color: var(--ink);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .glyph {
    position: absolute;
    top: 7px;
    width: 11px;
    height: 11px;
  }
  .moon {
    left: 7px;
    color: var(--street-line-mid);
  }
  .sun {
    right: 7px;
    color: var(--dot);
  }
  @media (max-width: 639px) {
    .label-text {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .plane-switch input:focus-visible + .track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .track {
    -webkit-mask-image: -webkit-radial-gradient(white, black);
    position: relative;
    overflow: hidden;
    width: 50px;
    height: 25px;
    padding: 1px;
    border-radius: 13px;
    /* Edge only in the dark theme, where the navy runway would otherwise melt into the #000814 page. */
    box-shadow: inset 0 0 0 1px light-dark(transparent, var(--street-line));
    background: linear-gradient(90deg, var(--street) 0%, var(--street) 25%, var(--sky-1) 75%, var(--sky-2) 100%) left
      var(--p, 0%) top 0;
    background-position-x: var(--p, 0%);
    background-size: 400% auto;
    transition: background-position 0.6s;
  }
  /* Light theme (chosen, or the system setting with no choice): plane in the sky. */
  :global(html[data-theme="light"]) .track {
    --p: 100%;
    --x: 25px;
    --s: -50px;
    --c: var(--sky-2);
    --co: 0.8;
    --co-2: 0.6;
  }
  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme="dark"])) .track {
      --p: 100%;
      --x: 25px;
      --s: -50px;
      --c: var(--sky-2);
      --co: 0.8;
      --co-2: 0.6;
    }
  }

  .track:before,
  .track:after {
    content: "";
    display: block;
    position: absolute;
    transform: translateX(var(--s, 0));
    transition: transform 0.3s;
  }
  .track:before {
    width: 42px;
    right: 2px;
    top: 4px;
    height: 1px;
    background: var(--street-line);
    box-shadow: 0 16px 0 0 var(--street-line);
  }
  .track:after {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    left: 23px;
    top: 1px;
    animation: lights2 2s linear infinite;
    box-shadow:
      inset 0 0 0 2px var(--light-1),
      0 21px 0 var(--light-1),
      8px 0 0 var(--light-2),
      8px 21px 0 var(--light-2),
      16px 0 0 var(--light-2),
      16px 21px 0 var(--light-2);
  }
  .track span {
    display: block;
    position: absolute;
  }
  .street-middle {
    top: 12px;
    left: 21px;
    width: 3px;
    height: 1px;
    transform: translateX(var(--s, 0));
    background: var(--street-line-mid);
    box-shadow:
      5px 0 0 var(--street-line-mid),
      10px 0 0 var(--street-line-mid),
      15px 0 0 var(--street-line-mid),
      20px 0 0 var(--street-line-mid),
      25px 0 0 var(--street-line-mid);
    transition: transform 0.3s;
  }
  .cloud {
    width: 12px;
    height: 4px;
    border-radius: 2px;
    background: #fff;
    top: var(--ct, 8px);
    left: 100%;
    opacity: var(--co, 0);
    transition: opacity 0.3s;
    animation: clouds2 2s linear infinite var(--cd, 0s);
  }
  .cloud:before,
  .cloud:after {
    content: "";
    position: absolute;
    transform: translateX(var(--cx, 0));
    border-radius: 50%;
    width: var(--cs, 5px);
    height: var(--cs, 5px);
    background: #fff;
    bottom: 1px;
    left: 1px;
  }
  .cloud:after {
    --cs: 6px;
    --cx: 4px;
  }
  .cloud.two {
    --ct: 20px;
    --cd: 1s;
    opacity: var(--co-2, 0);
  }
  .plane {
    display: table;
    position: relative;
    z-index: 1;
    padding: 5px;
    border-radius: 50%;
    background: var(--dot);
    transform: translateX(var(--x, 0));
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.35, 1.2);
  }
  .plane svg {
    width: 13px;
    height: 13px;
    display: block;
    color: var(--c, var(--street));
    transition: color 0.6s;
  }
  @media (prefers-reduced-motion: reduce) {
    .track,
    .track *,
    .track:before,
    .track:after {
      animation: none;
      transition: none;
    }
  }

  @keyframes lights2 {
    20%,
    30% {
      box-shadow:
        inset 0 0 0 2px var(--light-2),
        0 21px 0 var(--light-2),
        8px 0 0 var(--light-1),
        8px 21px 0 var(--light-1),
        16px 0 0 var(--light-2),
        16px 21px 0 var(--light-2);
    }
    55%,
    65% {
      box-shadow:
        inset 0 0 0 2px var(--light-2),
        0 21px 0 var(--light-2),
        8px 0 0 var(--light-2),
        8px 21px 0 var(--light-2),
        16px 0 0 var(--light-1),
        16px 21px 0 var(--light-1);
    }
    90%,
    100% {
      box-shadow:
        inset 0 0 0 2px var(--light-1),
        0 21px 0 var(--light-1),
        8px 0 0 var(--light-2),
        8px 21px 0 var(--light-2),
        16px 0 0 var(--light-2),
        16px 21px 0 var(--light-2);
    }
  }
  @keyframes clouds2 {
    97% {
      transform: translateX(-72px);
      visibility: visible;
    }
    98%,
    100% {
      visibility: hidden;
    }
    99% {
      transform: translateX(-72px);
    }
    100% {
      transform: translateX(0);
    }
  }
  @media print {
    .plane-switch {
      display: none;
    }
  }
</style>
