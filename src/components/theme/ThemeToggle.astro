---
// Nav button that switches between light and dark and remembers the choice for the next visit.
// The icon shows the theme the button switches TO: a moon in light mode, a sun in dark mode.
---

<button class="theme-toggle" type="button" aria-label="Switch to dark theme">
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
  </svg>
</button>

<script>
  import { isTheme, THEME_ATTRIBUTE, THEME_STORAGE_KEY, type Theme } from "../../site/theme";

  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");

  function currentTheme(): Theme {
    const chosen = root.getAttribute(THEME_ATTRIBUTE);
    if (isTheme(chosen)) return chosen;
    return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function label(theme: Theme): string {
    return theme === "dark" ? "Switch to light theme" : "Switch to dark theme";
  }

  function apply(theme: Theme): void {
    root.setAttribute(THEME_ATTRIBUTE, theme);
    button?.setAttribute("aria-label", label(theme));
    try {
      localStorage.setItem(THEME_STORAGE_KEY, theme);
    } catch {
      // Storage blocked: the choice lasts for this page view only.
    }
  }

  button?.setAttribute("aria-label", label(currentTheme()));
  button?.addEventListener("click", () => apply(currentTheme() === "dark" ? "light" : "dark"));
</script>

<style>
  /* Sticky so it stays in view while the nav links scroll sideways on narrow screens. */
  .theme-toggle {
    position: sticky;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sun {
    display: none;
  }
  :global(html[data-theme="dark"]) .moon {
    display: none;
  }
  :global(html[data-theme="dark"]) .sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .moon {
      display: none;
    }
    :global(html:not([data-theme="light"])) .sun {
      display: block;
    }
  }
</style>
