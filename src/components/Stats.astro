---
// Tiles of headline numbers: the profile stats on the home page, a project's metrics on its page.
import type { Stat } from "../site/profile";

interface Props {
  stats: readonly Stat[];
}

const { stats } = Astro.props;
---

<div class="stats">
  {stats.map((stat) => (
    <div class="stat">
      <b>{stat.value}</b>
      <span>{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    margin: 8px 0 8px;
  }
  .stat {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 16px;
  }
  .stat b {
    display: block;
    font-size: 26px;
    color: var(--accent);
    line-height: 1.2;
  }
  .stat span {
    font-size: 14px;
    color: var(--muted);
  }
</style>
