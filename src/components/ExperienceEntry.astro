---
// One job from the experience collection: heading, place and dates, optional context note, bullet list.
import BeforeAfterChart from "./charts/BeforeAfterChart.astro";
import { bulletsFor, smartQuotes } from "../site/bullets";
import { monthLabel } from "../site/month";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const { title, org, location, start, end, note, bullets, results } = entry.data;
const heading = title ? `${title} · ${org}` : org;
const meta = `${location} · ${monthLabel(start)} – ${end ? monthLabel(end) : "Present"}`;
---

<div class="item">
  <div class="item-head">
    <h3>{heading}</h3>
    <span class="meta">{meta}</span>
  </div>
  {note && <p class="note">{note}</p>}
  <ul>
    {bulletsFor(bullets).map((text) => (
      <li>{smartQuotes(text)}</li>
    ))}
  </ul>
  <BeforeAfterChart headingLevel="h4" results={results} id={`exp-${entry.id}`} />
</div>
