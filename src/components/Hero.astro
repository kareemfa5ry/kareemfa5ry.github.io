---
// Page header: name, tagline, three proof numbers, a CV button per role, the chat opener, contact and availability,
// over a decorative spinning globe (HeroGlobe) behind its right side; the header isolates it so the text stays on top.
import { EMAIL, FULL_NAME, LINKEDIN_URL, LOCATION, MAILTO } from "../site/contact";
import { CV_FILES } from "../site/cv_files";
import { getCollection } from "astro:content";
import { byOrder } from "../site/collections/by_order";
import HeroGlobe from "./hero/HeroGlobe.astro";
import { AVAILABILITY_BADGES, AVAILABILITY_DETAILS, HERO_STATS } from "../site/profile";

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
const entries = byOrder(await getCollection("experience"));
const employers = [...new Set(entries.map((entry) => entry.data.org))];
---

<header>
  <HeroGlobe />
  <h1>{FULL_NAME}</h1>
  <p class="tagline">{tagline}</p>
  <ul class="badges">
    {AVAILABILITY_BADGES.map((label, i) => (
      <li class="chip">
        {i === 0 && <span class="dot" aria-hidden="true" />}
        {label}
      </li>
    ))}
  </ul>
  <p class="employers">Worked with {employers.join(", ")}</p>
  <ul class="proof">
    {HERO_STATS.map((stat, i) => (
      <li class="card" style={`--i:${i}`}>
        <b>{stat.value}</b> {stat.label}
      </li>
    ))}
  </ul>
  <div class="cta">
    {CV_FILES.map((cv) => (
      <a class="btn primary" href={cv.href} download>
        {cv.title} CV
      </a>
    ))}
    <button type="button" class="btn secondary" data-chat-open aria-expanded="false">
      <span class="when-closed">Ask about Kareem</span>
      <span class="when-open">Minimize the chat</span>
    </button>
  </div>
  <div class="contact">
    <span>{LOCATION}</span>
    <a href={MAILTO}>{EMAIL}</a>
    <a href={LINKEDIN_URL} target="_blank" rel="noopener">
      LinkedIn
    </a>
  </div>
  <p class="availability">{AVAILABILITY_DETAILS.join(" ")}</p>
</header>

<style>
  header {
    position: relative;
    isolation: isolate;
    padding: 64px 0 40px;
  }
  h1 {
    font-size: clamp(30px, 6vw, 44px);
    line-height: 1.15;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .employers {
    font-size: 15px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .proof li {
    padding: var(--space-4);
    flex: 1 1 160px;
  }
  .proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    margin: 0 0 24px;
    font-size: 14px;
    color: var(--muted);
  }
  .proof b {
    display: block;
    color: var(--accent);
    font-size: 24px;
    line-height: 1.2;
  }
  @media (min-width: 48rem) {
    .proof {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .availability {
    font-size: 14px;
    color: var(--muted);
    margin: 12px 0 0;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 15px;
    color: var(--muted);
    margin: 20px 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .proof li {
      animation: tile-in 0.5s ease-out both;
      animation-delay: calc(var(--i) * 120ms);
    }
    .dot {
      animation: pulse 2s ease-in-out infinite;
    }
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media print {
    .cta {
      display: none;
    }
  }
</style>
