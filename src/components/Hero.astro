---
// Page header: name, tagline, three proof numbers, a CV button per role, the chat opener, contact and availability.
import { EMAIL, FULL_NAME, LINKEDIN_URL, LOCATION, MAILTO } from "../site/contact";
import { CV_FILES } from "../site/cv_files";
import { AVAILABILITY, HERO_STATS } from "../site/profile";

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<header>
  <h1>{FULL_NAME}</h1>
  <p class="tagline">{tagline}</p>
  <ul class="proof">
    {HERO_STATS.map((stat) => (
      <li>
        <b>{stat.value}</b> {stat.label}
      </li>
    ))}
  </ul>
  <div class="cta">
    {CV_FILES.map((cv, i) => (
      <a class={`btn ${i === 0 ? "primary" : "secondary"}`} href={cv.href} download>
        {cv.title} CV
      </a>
    ))}
    <button type="button" class="btn secondary" data-chat-open>
      Ask about Kareem
    </button>
  </div>
  <div class="contact">
    <span>{LOCATION}</span>
    <a href={MAILTO}>{EMAIL}</a>
    <a href={LINKEDIN_URL} target="_blank" rel="noopener">
      LinkedIn
    </a>
  </div>
  <p class="availability">{AVAILABILITY.join(" ")}</p>
</header>

<style>
  header {
    padding: 64px 0 40px;
  }
  h1 {
    font-size: clamp(30px, 6vw, 44px);
    line-height: 1.15;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .proof {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0;
    margin: 0 0 24px;
    font-size: 14px;
    color: var(--muted);
  }
  .proof b {
    display: block;
    color: var(--accent);
    font-size: 24px;
    line-height: 1.2;
  }
  @media (min-width: 48rem) {
    .proof {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .availability {
    font-size: 14px;
    color: var(--muted);
    margin: 12px 0 0;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 15px;
    color: var(--muted);
    margin: 20px 0 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media print {
    .cta {
      display: none;
    }
  }
</style>
