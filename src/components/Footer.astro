---
// Page footer: copyright line and email.
import { EMAIL, FULL_NAME, MAILTO } from "../site/contact";
---

<footer>
  <div class="wrap">
    © 2026 {FULL_NAME} · <a href={MAILTO}>{EMAIL}</a>
  </div>
</footer>

<style>
  footer {
    padding: 32px 0 48px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 14px;
  }
</style>
