---
// Closing section: how to reach Kareem. The CV downloads live in Downloads.astro, not repeated here.
import { CHAT_ENABLED } from "../../site/chat";
import { EMAIL, LINKEDIN_LABEL, LINKEDIN_URL, LOCATION, MAILTO } from "../../site/contact";
import { AVAILABILITY, AVAILABILITY_BADGES } from "../../site/profile";
---

<section id="contact">
  <h2>Contact</h2>
  <div class="card box">
    <ul class="badges">
      {AVAILABILITY_BADGES.map((badge) => (
        <li class="chip">{badge}</li>
      ))}
    </ul>
    <ul class="lines">
      {AVAILABILITY.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
    <p class="where">{LOCATION}</p>
    <div class="cta">
      <a class="btn primary" href={MAILTO}>
        {EMAIL}
      </a>
      <a class="btn" href={LINKEDIN_URL} target="_blank" rel="noopener">
        {LINKEDIN_LABEL}
      </a>
      {CHAT_ENABLED && (
        <button type="button" class="btn" data-chat-open aria-expanded="false">
          <span class="when-closed">Ask the assistant</span>
          <span class="when-open">Minimize the chat</span>
        </button>
      )}
    </div>
  </div>
</section>

<style>
  .box {
    padding: var(--space-5);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .lines {
    margin: var(--space-4) 0 0;
    color: var(--muted);
  }
  .where {
    margin: var(--space-2) 0 var(--space-4);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  @media print {
    [data-chat-open] {
      display: none;
    }
  }
</style>
