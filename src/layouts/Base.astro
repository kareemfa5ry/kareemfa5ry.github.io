---
// Page shell: head (meta, OG tags, favicon, global stylesheet), the globe backdrop, nav, main slot, footer.
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import GlobeBackdrop from "../components/hero/GlobeBackdrop.astro";
import ChatWidget from "../islands/ChatWidget.tsx";
import { CHAT, CHAT_ENABLED } from "../site/chat";

interface Props {
  title: string;
  description: string;
  ogDescription: string;
  /** schema.org record to embed as JSON-LD; the home page passes one. */
  jsonLd?: object;
  /** number the section headings 01, 02, ... (the home page does; see global.css). */
  numbered?: boolean;
}

const { title, description, ogDescription, jsonLd, numbered } = Astro.props;

const OG_IMAGE = new URL("/og.png", Astro.site).href;
const OG_IMAGE_ALT = "Kareem Fakhry, senior data analyst and revenue manager: headline figures from his CV";

const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23003566'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='700' font-size='15' fill='%23ffc300' text-anchor='middle'%3EKF%3C/text%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Phone browser bar matches the page: --bg of public/theme.css per system theme (tests/e2e/mobile). -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#eef3fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000814" />
    <link rel="stylesheet" href="/theme.css" />
    <script is:inline src="/theme.js"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={FAVICON} />
    <link rel="alternate" type="application/json" href="/resume.json" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <GlobeBackdrop />
    <Nav />
    <main class:list={["wrap", { numbered }]} id="top">
      <slot />
    </main>
    <Footer />
    {CHAT_ENABLED && <ChatWidget client:idle workerUrl={CHAT.workerUrl} siteKey={CHAT.turnstileSiteKey} />}
  </body>
</html>
